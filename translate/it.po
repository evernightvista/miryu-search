#: contents/ui/ConfigGeneral.qml:35 contents/ui/main.qml:43
msgid "Show icon only"
msgstr "Mostra solo l'icona"

#: contents/ui/ConfigGeneral.qml:39
msgid ""
"In icon-only mode, the search field moves to the top of the search window. "
"You can also right-click the search box to toggle this."
msgstr ""
"In modalità solo icona, il campo di ricerca viene spostato in cima alla "
"finestra di ricerca. È anche possibile fare clic destro sulla casella di "
"ricerca per attivare/disattivare questa modalità."

#: contents/ui/ConfigGeneral.qml:48
msgid "Web search engine:"
msgstr "Motore di ricerca web:"

#: contents/ui/ConfigGeneral.qml:51
msgid "Follow KDE settings"
msgstr "Segui le impostazioni di KDE"

#: contents/ui/ConfigGeneral.qml:58
msgid ""
"“Follow KDE settings” uses the default engine chosen in System Settings › "
"Web Search Keywords."
msgstr ""
"«Segui le impostazioni di KDE» usa il motore predefinito scelto in "
"Impostazioni di sistema › Parole chiave di ricerca web."

