#: contents/ui/ConfigGeneral.qml:51
msgid "Follow KDE settings"
msgstr "KDE-instellingen volgen"

#: contents/ui/ConfigGeneral.qml:58
msgid ""
"“Follow KDE settings” uses the default engine chosen in System Settings › "
"Web Search Keywords."
msgstr ""
"‘KDE-instellingen volgen’ gebruikt de standaardzoekmachine uit "
"Systeeminstellingen › Webzoeksleutelwoorden."

